---
export interface ConsentCategory {
	/** Storage key for this category — must be stable across deploys. */
	id: string;
	/** Toggle label. */
	label: string;
	/** Optional helper text shown under the label. */
	description?: string;
	/** Pre-checks this category. Leave false for genuine opt-in consent —
	 * only set true if you're confident this category is legitimately
	 * pre-selectable under your jurisdiction. */
	default?: boolean;
}

export interface Props {
	/** Banner heading. Pass `""` to omit it entirely. */
	title?: string;
	/** Main banner text. */
	message?: string;
	/** Accept button label. Defaults to "Accept" (or "Accept all" if `categories` is set). */
	acceptLabel?: string;
	/** Decline button label. Defaults to "Decline" (or "Decline all" if `categories` is set). */
	declineLabel?: string;
	/** "Save preferences" button label, only shown when `categories` is set. */
	saveLabel?: string;
	/** If set, renders a link to your privacy policy after the message. */
	privacyHref?: string;
	/** Link text for the privacy policy link. */
	privacyLabel?: string;
	/** Show a small persistent button to reopen the banner and change the choice later. */
	showReopenButton?: boolean;
	/** Reopen button label. */
	reopenLabel?: string;
	/** Reopen button aria-label. */
	reopenAriaLabel?: string;
	/** Per-category consent (e.g. analytics/marketing) instead of a single accept/decline. */
	categories?: ConsentCategory[];
	/** How long a choice stays valid before the banner is shown again. Defaults to 365. */
	expiryDays?: number;
	/** Render inline wherever you place it (e.g. a settings/preferences page)
	 * instead of floating as a fixed bottom-left card. Skips the `<body>`
	 * reparenting used to escape ancestor stacking contexts, since an
	 * intentionally embedded banner has nothing to escape from. */
	embedded?: boolean;
}

const {
	title = 'We value your privacy',
	message = 'We use cookies to enhance your experience. You can accept or decline them.',
	acceptLabel,
	declineLabel,
	saveLabel = 'Save preferences',
	privacyHref,
	privacyLabel = 'privacy policy',
	showReopenButton = true,
	reopenLabel = 'Cookie settings',
	reopenAriaLabel = 'Change cookie preferences',
	categories = [],
	expiryDays = 365,
	embedded = false,
} = Astro.props;

const hasCategories = categories.length > 0;
const resolvedAcceptLabel = acceptLabel ?? (hasCategories ? 'Accept all' : 'Accept');
const resolvedDeclineLabel = declineLabel ?? (hasCategories ? 'Decline all' : 'Decline');
const categoryIds = categories.map((category) => category.id);
---

<div
	id="cookie-consent-banner"
	class="cc-banner"
	hidden
	data-cc-expiry-days={expiryDays}
	data-cc-categories={hasCategories ? JSON.stringify(categoryIds) : ''}
	data-cc-embedded={embedded ? 'true' : undefined}
>
	{
		title && (
			<div class="cc-header">
				<svg class="cc-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M12 2a10 10 0 1 0 9.95 11.02.9.9 0 0 0-1.1-.98 3 3 0 0 1-3.51-3.51.9.9 0 0 0-1.1-1.1 3 3 0 0 1-3.6-3.6.9.9 0 0 0-.9-1.06A10 10 0 0 0 12 2Z"
						fill="currentColor"
					/>
					<circle cx="9" cy="12" r="1.1" fill="var(--cc-bg, var(--cc-default-bg))" />
					<circle cx="13" cy="16" r="1.1" fill="var(--cc-bg, var(--cc-default-bg))" />
					<circle cx="8.5" cy="16.5" r="0.9" fill="var(--cc-bg, var(--cc-default-bg))" />
				</svg>
				<h2 class="cc-title">{title}</h2>
			</div>
		)
	}

	<p class="cc-message">
		{message}
		{
			privacyHref && (
				<>
					{' '}
					<a href={privacyHref}>{privacyLabel}</a>.
				</>
			)
		}
	</p>

	{
		hasCategories && (
			<ul class="cc-categories">
				{categories.map((category) => (
					<li>
						<label class="cc-category">
							<span class="cc-category-text">
								<span class="cc-category-label">{category.label}</span>
								{category.description && (
									<span class="cc-category-description">{category.description}</span>
								)}
							</span>
							<span class="cc-switch">
								<input
									type="checkbox"
									role="switch"
									data-cc-category={category.id}
									checked={category.default ?? false}
								/>
							</span>
						</label>
					</li>
				))}
			</ul>
		)
	}

	<div class="cc-actions">
		<button type="button" data-cc-choice="decline" class="cc-decline">{resolvedDeclineLabel}</button
		>
		{
			hasCategories && (
				<button type="button" data-cc-choice="save" class="cc-save">
					{saveLabel}
				</button>
			)
		}
		<button type="button" data-cc-choice="accept" class="cc-accept">{resolvedAcceptLabel}</button>
	</div>
</div>

{
	showReopenButton && (
		<button
			type="button"
			id="cookie-consent-reopen"
			class="cc-reopen"
			hidden
			aria-label={reopenAriaLabel}
			data-cc-embedded={embedded ? 'true' : undefined}
		>
			{reopenLabel}
		</button>
	)
}

<script is:inline>
	(() => {
		const STORAGE_KEY = 'cookie-consent';
		const EVENT_NAME = 'cookie-consent-changed';
		const banner = document.getElementById('cookie-consent-banner');
		const reopenBtn = document.getElementById('cookie-consent-reopen');
		if (!banner) return;

		// A floating consent banner must always be reachable — but
		// `position: fixed` is trapped by any ancestor with `isolation`,
		// `transform`, `filter`, or `will-change` (common in real layouts, e.g.
		// Tailwind's `isolate` utility), which silently breaks its stacking
		// regardless of z-index. Moving it to be a direct child of <body>
		// sidesteps that entirely. Skipped for `embedded` banners, which are
		// deliberately placed inline and have nothing to escape from.
		if (banner.dataset.ccEmbedded !== 'true') {
			if (banner.parentElement !== document.body) document.body.appendChild(banner);
			if (reopenBtn && reopenBtn.parentElement !== document.body) {
				document.body.appendChild(reopenBtn);
			}
		}

		const expiryDays = Number(banner.dataset.ccExpiryDays) || 365;
		const categoryIds = banner.dataset.ccCategories
			? JSON.parse(banner.dataset.ccCategories)
			: null;

		const readRecord = () => {
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				if (!raw) return null;
				const record = JSON.parse(raw);
				if (
					!record ||
					typeof record.timestamp !== 'number' ||
					typeof record.categories !== 'object' ||
					record.categories === null
				) {
					return null;
				}
				return record;
			} catch {
				return null;
			}
		};

		const isExpired = (record) =>
			!record || Date.now() - record.timestamp > expiryDays * 24 * 60 * 60 * 1000;

		const writeRecord = (categories) => {
			const record = { categories, timestamp: Date.now() };
			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify(record));
			} catch {
				/* localStorage unavailable — consent just won't persist */
			}
			return record;
		};

		const dispatchChange = (record) => {
			window.dispatchEvent(new CustomEvent(EVENT_NAME, { detail: record }));
		};

		const checkboxes = () => Array.from(banner.querySelectorAll('[data-cc-category]'));

		const syncCheckboxes = (record) => {
			if (!categoryIds || !record) return;
			for (const checkbox of checkboxes()) {
				const id = checkbox.dataset.ccCategory;
				if (id in record.categories) checkbox.checked = record.categories[id];
			}
		};

		const showBanner = () => {
			banner.hidden = false;
			if (reopenBtn) reopenBtn.hidden = true;
		};

		const showReopen = () => {
			banner.hidden = true;
			if (reopenBtn) reopenBtn.hidden = false;
		};

		const applyRecord = (categories) => {
			const record = writeRecord(categories);
			showReopen();
			dispatchChange(record);
		};

		banner.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const choice = target.dataset.ccChoice;
			if (!choice) return;

			if (choice === 'accept') {
				const categories = categoryIds
					? Object.fromEntries(categoryIds.map((id) => [id, true]))
					: { all: true };
				applyRecord(categories);
			} else if (choice === 'decline') {
				const categories = categoryIds
					? Object.fromEntries(categoryIds.map((id) => [id, false]))
					: { all: false };
				applyRecord(categories);
			} else if (choice === 'save') {
				const categories = Object.fromEntries(
					checkboxes().map((checkbox) => [checkbox.dataset.ccCategory, checkbox.checked]),
				);
				applyRecord(categories);
			}
		});

		reopenBtn?.addEventListener('click', () => {
			syncCheckboxes(readRecord());
			showBanner();
		});

		const stored = readRecord();
		if (!isExpired(stored)) {
			syncCheckboxes(stored);
			showReopen();
			dispatchChange(stored);
		} else {
			showBanner();
		}
	})();
</script>

<style>
	/*
	 * Theme-aware fallbacks for the 7 public --cc-* variables. These only apply
	 * when the consuming site hasn't set --cc-bg/--cc-fg/--cc-border itself —
	 * an explicit override on :root always wins outright, var() fallbacks only
	 * kick in when the variable is unset. `:global()` is required here because
	 * Astro would otherwise scope `:root` to only match elements this
	 * component renders, which doesn't include <html>.
	 */
	:global(:root) {
		--cc-default-bg: #1f1f1f;
		--cc-default-fg: #f5f5f5;
		--cc-default-border: rgba(255, 255, 255, 0.14);
	}

	@media (prefers-color-scheme: light) {
		:global(:root) {
			--cc-default-bg: #ffffff;
			--cc-default-fg: #1a1a1a;
			--cc-default-border: rgba(0, 0, 0, 0.14);
		}
	}

	:global(:root[data-theme='dark']) {
		--cc-default-bg: #1f1f1f;
		--cc-default-fg: #f5f5f5;
		--cc-default-border: rgba(255, 255, 255, 0.14);
	}

	:global(:root[data-theme='light']) {
		--cc-default-bg: #ffffff;
		--cc-default-fg: #1a1a1a;
		--cc-default-border: rgba(0, 0, 0, 0.14);
	}

	.cc-banner {
		position: fixed;
		left: 1rem;
		bottom: 1rem;
		z-index: 9999;
		max-width: 400px;
		background-color: var(--cc-bg, var(--cc-default-bg));
		color: var(--cc-fg, var(--cc-default-fg));
		border: 1px solid var(--cc-border, var(--cc-default-border));
		border-radius: var(--cc-radius, 14px);
		padding: 1.5rem;
		box-shadow:
			0 20px 40px rgba(0, 0, 0, 0.25),
			0 2px 8px rgba(0, 0, 0, 0.15);
		font-family: var(--cc-font, system-ui, sans-serif);
	}

	.cc-header {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.5rem;
	}

	.cc-icon {
		flex-shrink: 0;
		width: 22px;
		height: 22px;
		color: var(--cc-accent, #4f46e5);
	}

	.cc-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.3;
		/* Consuming sites very commonly style h1-h6 inside their own content
		   areas (docs themes, blogs, prose resets) — without an explicit color
		   here, .cc-title would inherit that instead of --cc-fg. */
		color: var(--cc-fg, var(--cc-default-fg)) !important;
	}

	.cc-message {
		margin: 0 0 1.25rem;
		font-size: 0.85rem;
		line-height: 1.6;
		opacity: 0.85;
		color: var(--cc-fg, var(--cc-default-fg)) !important;
	}

	.cc-banner a {
		color: inherit;
		text-decoration: underline;
	}

	.cc-categories {
		list-style: none;
		margin: 0 0 1.25rem;
		padding: 0;
	}

	.cc-category {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 0;
		border-top: 1px solid var(--cc-border, var(--cc-default-border));
		cursor: pointer;
	}

	.cc-categories li:first-child .cc-category {
		border-top: none;
		padding-top: 0;
	}

	.cc-category-text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.cc-category-label {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--cc-fg, var(--cc-default-fg)) !important;
	}

	.cc-category-description {
		font-size: 0.75rem;
		line-height: 1.5;
		opacity: 0.7;
		color: var(--cc-fg, var(--cc-default-fg)) !important;
	}

	.cc-switch {
		flex-shrink: 0;
		display: inline-flex;
	}

	.cc-switch input {
		appearance: none;
		-webkit-appearance: none;
		margin: 0;
		width: 38px;
		height: 22px;
		border-radius: 999px;
		background-color: var(--cc-border, var(--cc-default-border));
		position: relative;
		cursor: pointer;
		transition: background-color 0.15s ease;
	}

	.cc-switch input::before {
		content: '';
		position: absolute;
		top: 2px;
		left: 2px;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background-color: #fff;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
		transition: transform 0.15s ease;
	}

	.cc-switch input:checked {
		background-color: var(--cc-accent, #4f46e5);
	}

	.cc-switch input:checked::before {
		transform: translateX(16px);
	}

	.cc-switch input:focus-visible {
		outline: 2px solid var(--cc-accent, #4f46e5);
		outline-offset: 2px;
	}

	.cc-actions {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
		gap: 0.6rem;
	}

	.cc-actions button {
		/* Grid's default row-stretch reliably equalizes button heights even
		   when one label wraps to two lines and its siblings don't — flex's
		   `flex: 1` (flex-basis: 0%) + wrapping text is a known combination
		   that can produce mismatched heights depending on container width. */
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.65rem 1rem;
		border: 1px solid var(--cc-border, var(--cc-default-border));
		background: transparent;
		color: inherit;
		cursor: pointer;
		border-radius: calc(var(--cc-radius, 14px) - 6px);
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;
	}

	.cc-actions button:hover {
		border-color: currentColor;
	}

	.cc-save {
		background-color: var(--cc-accent, #4f46e5) !important;
		border-color: var(--cc-accent, #4f46e5) !important;
		color: var(--cc-accent-fg, #fff) !important;
	}

	.cc-reopen[hidden] {
		display: none;
	}

	.cc-reopen {
		position: fixed;
		left: 1rem;
		bottom: 1rem;
		z-index: 9999;
		display: inline-flex;
		align-items: center;
		background-color: var(--cc-bg, var(--cc-default-bg));
		color: var(--cc-fg, var(--cc-default-fg));
		border: 1px solid var(--cc-border, var(--cc-default-border));
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.55rem 1.1rem;
		cursor: pointer;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
		opacity: 0.9;
		font-family: var(--cc-font, system-ui, sans-serif);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.cc-reopen:hover {
		opacity: 1;
		transform: translateY(-1px);
	}

	@media (max-width: 640px) {
		.cc-banner {
			left: 0.5rem;
			right: 0.5rem;
			bottom: 0.5rem;
			max-width: none;
			padding: 1.25rem;
		}
	}

	/* embedded: render inline wherever placed instead of floating. Specificity
	   (class + attribute) beats the base .cc-banner/.cc-reopen rules on its
	   own, no !important needed. */
	.cc-banner[data-cc-embedded] {
		position: static;
		left: auto;
		bottom: auto;
		z-index: auto;
		max-width: none;
		width: 100%;
	}

	.cc-reopen[data-cc-embedded] {
		position: static;
		left: auto;
		bottom: auto;
		z-index: auto;
	}
</style>
